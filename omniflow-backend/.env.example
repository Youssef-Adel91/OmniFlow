# ════════════════════════════════════════════════════════════════════════════════
# OmniFlow AI — Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════════
#
# USAGE:
#   cp .env.example .env
#   # Fill in all values marked with <REQUIRED> before running.
#   # Values with defaults are safe for local development only.
#
# SECURITY WARNING:
#   - NEVER commit the actual .env file to version control.
#   - In production, use AWS Secrets Manager / HashiCorp Vault.
#   - All secrets must be rotated before going to production.
#
# ════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="OmniFlow AI"
APP_ENV=development                        # development | staging | production
APP_VERSION="2.0.0"
APP_DEBUG=true                             # Set to false in production!
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_FORMAT=json                        # json | text
APP_WORKERS=4                              # Uvicorn worker count (prod: 2*CPU+1)
APP_TIMEZONE=Asia/Riyadh

# API Base URL (used in webhook registrations, pre-signed URL generation, etc.)
API_BASE_URL=http://localhost:8000         # <REQUIRED> Set to your public HTTPS URL in prod
FRONTEND_URL=http://localhost:3000         # <REQUIRED> Next.js frontend URL (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY & JWT
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=<REQUIRED_generate_a_256_bit_random_hex_secret>

# NOTE: JWT_* below belongs to the DEPRECATED local auth system. Clerk is the
# only supported identity provider (see src/gateway/routers/auth.py). These
# values are still required by Settings but are no longer used for login.
JWT_SECRET_KEY=<REQUIRED_generate_a_256_bit_random_hex_secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Clerk (official identity provider) ───────────────────────────────────────
CLERK_SECRET_KEY=<REQUIRED>
CLERK_PUBLISHABLE_KEY=<REQUIRED>
# Svix signing secret from Clerk Dashboard → Webhooks → Signing Secret.
# MANDATORY in production: without it the /api/v1/webhooks/clerk endpoint is
# rejected (503) rather than accepting unverified tenant-provisioning events.
CLERK_WEBHOOK_SECRET=<REQUIRED>

# HMAC secret for Meta Webhook signature verification (X-Hub-Signature-256)
META_WEBHOOK_HMAC_SECRET=<REQUIRED_copy_from_meta_developer_console>

# Encryption key for PII fields at rest (AES-256)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<REQUIRED_fernet_key_base64>

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (OLTP)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omniflow_db
POSTGRES_USER=omniflow
POSTGRES_PASSWORD=<REQUIRED_strong_password>
POSTGRES_SCHEMA=public
POSTGRES_SSL_MODE=disable                  # require | verify-full in production

# Connection pool sizing
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_COMMAND_TIMEOUT=30               # seconds

# Full async connection string (overrides individual vars if set)
# DATABASE_URL=postgresql+asyncpg://omniflow:<password>@localhost:5432/omniflow_db

# PgBouncer (transaction pooler) — use this URL in services, NOT the direct PG URL
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PGBOUNCER_HOST}:${PGBOUNCER_PORT}/${POSTGRES_DB}

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<REQUIRED_strong_password>
REDIS_SSL=false                            # true in production
REDIS_MAX_CONNECTIONS=100

# Database indices (separate logical DBs for isolation)
REDIS_DB_CONVERSATIONS=0      # Conversation context & session state
REDIS_DB_RATE_LIMITING=1      # Rate limiting counters
REDIS_DB_IDEMPOTENCY=2        # Idempotency keys (payments, webhooks)
REDIS_DB_CELERY_BROKER=3      # Celery task broker
REDIS_DB_CELERY_RESULTS=4     # Celery results backend
REDIS_DB_CACHE=5              # General application cache

REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB_CONVERSATIONS}
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB_CELERY_BROKER}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB_CELERY_RESULTS}

# Cache TTLs (seconds)
CONVERSATION_CONTEXT_TTL=86400   # 24 hours
SESSION_STATE_TTL=3600           # 1 hour
RATE_LIMIT_WINDOW=60             # 1 minute window
IDEMPOTENCY_KEY_TTL=604800       # 7 days
REGA_VERIFICATION_CACHE_TTL=604800 # 7 days

# ─────────────────────────────────────────────────────────────────────────────
# Kafka / Redpanda
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT          # SASL_SSL in production
KAFKA_SASL_MECHANISM=                      # SCRAM-SHA-512 in production
KAFKA_SASL_USERNAME=                       # <REQUIRED in prod>
KAFKA_SASL_PASSWORD=                       # <REQUIRED in prod>
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Consumer groups (one per service class)
KAFKA_CONSUMER_GROUP_INGESTION=omniflow.ingestion.v1
KAFKA_CONSUMER_GROUP_AI_WORKERS=omniflow.ai-workers.v1
KAFKA_CONSUMER_GROUP_VAULT_WORKERS=omniflow.vault-workers.v1
KAFKA_CONSUMER_GROUP_BROADCAST_WORKERS=omniflow.broadcast-workers.v1
KAFKA_CONSUMER_GROUP_NOTIFICATION_SVC=omniflow.notification-svc.v1
KAFKA_CONSUMER_GROUP_CLICKHOUSE=omniflow.clickhouse-consumer.v1

# Kafka Topics (must match topic creation in infra/redpanda/topics.sh)
KAFKA_TOPIC_MESSAGES_INCOMING=messages.incoming.v1
KAFKA_TOPIC_MESSAGES_OUTGOING=messages.outgoing.v1
KAFKA_TOPIC_MESSAGES_OUTGOING_HUMAN=messages.outgoing.human.v1
KAFKA_TOPIC_LLM_ROUTING=llm.routing.v1
KAFKA_TOPIC_MULTIMODAL_AUDIO=multimodal.audio.v1
KAFKA_TOPIC_MULTIMODAL_VISION=multimodal.vision.v1
KAFKA_TOPIC_BROADCAST_MARKETING=broadcast.marketing.v1
KAFKA_TOPIC_ANALYTICS_EVENTS=analytics.events.v1
KAFKA_TOPIC_CONVERSATIONS_UPDATES=conversations.updates.v1
KAFKA_TOPIC_VAULT_RETRIEVAL=vault.retrieval.v1
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events.v1

# Producer settings
KAFKA_MAX_IN_FLIGHT_REQUESTS=5
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_ACKS=all
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_LINGER_MS=5
KAFKA_BATCH_SIZE=65536

# Consumer settings
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_RECORDS=500
KAFKA_SESSION_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant — Vector Database
# ─────────────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=<REQUIRED_strong_api_key>
QDRANT_USE_GRPC=true                       # Prefer gRPC for performance
QDRANT_PREFER_GRPC=true
QDRANT_TIMEOUT=30

# Collection naming convention: tenant_{tenant_uuid}_{type}
QDRANT_SHARED_KNOWLEDGE_COLLECTION=omniflow_shared_knowledge
QDRANT_SEMANTIC_CACHE_COLLECTION=omniflow_semantic_cache

# Semantic Cache thresholds (cosine similarity)
SEMANTIC_CACHE_HIT_THRESHOLD=0.95          # >= 0.95 → return cached response
SEMANTIC_CACHE_NEAR_HIT_THRESHOLD=0.85     # 0.85-0.95 → use as context hint
SEMANTIC_CACHE_TTL_SECONDS=604800          # 7 days

# RAG retrieval settings
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_RERANKED_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=4096
RAG_CHUNK_SIZE=400                         # target tokens per chunk
RAG_CHUNK_OVERLAP=60                       # 15% overlap

# ─────────────────────────────────────────────────────────────────────────────
# ClickHouse — OLAP Analytics
# ─────────────────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=omniflow_analytics
CLICKHOUSE_USER=omniflow
CLICKHOUSE_PASSWORD=<REQUIRED_strong_password>
CLICKHOUSE_SECURE=false                    # true in production

# ─────────────────────────────────────────────────────────────────────────────
# AWS / Object Storage
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=me-south-1                      # Bahrain region for data residency
AWS_ACCESS_KEY_ID=<REQUIRED>
AWS_SECRET_ACCESS_KEY=<REQUIRED>

# S3 Buckets
S3_VAULT_BUCKET=omniflow-reports-vault     # Permanent encrypted reports
S3_MEDIA_TEMP_BUCKET=omniflow-media-temp   # Temp voice/image files (24h TTL)
S3_ASSETS_BUCKET=omniflow-public-assets    # VCard logos, etc.
# Knowledge Base uploads (PDF/DOCX/TXT/CSV). MUST be private — unlike the
# assets bucket these are the tenant's internal business documents.
S3_KNOWLEDGE_BUCKET=omniflow-knowledge-docs

# For local dev: Use MinIO instead of AWS S3
S3_ENDPOINT_URL=http://localhost:9020      # MinIO endpoint (unset for real AWS)
S3_USE_PATH_STYLE=true                     # Required for MinIO
MINIO_ROOT_USER=omniflow_admin
MINIO_ROOT_PASSWORD=<REQUIRED_strong_password>

# Pre-signed URL TTL
VAULT_PRESIGNED_URL_TTL_SECONDS=900        # 15 minutes

# KMS (per-tenant encryption) — AWS KMS in prod, dummy in dev
KMS_MASTER_KEY_ARN=                        # <REQUIRED in prod>
KMS_DEV_MOCK_KEY=true                      # Use local mock KMS in dev

# ─────────────────────────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API
# ─────────────────────────────────────────────────────────────────────────────
META_APP_ID=<REQUIRED>
META_APP_SECRET=<REQUIRED>
META_GRAPH_API_VERSION=v21.0
META_GRAPH_API_BASE=https://graph.facebook.com

# WhatsApp Business Account
META_WHATSAPP_PHONE_NUMBER_ID=<REQUIRED>
META_WHATSAPP_BUSINESS_ACCOUNT_ID=<REQUIRED>
META_WHATSAPP_ACCESS_TOKEN=<REQUIRED_permanent_system_user_token>
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=<REQUIRED_generate_random_string>

# Rate limits (Meta enforces these per WABA)
META_WHATSAPP_RATE_LIMIT_PER_SECOND=80     # Messages per second per WABA
META_WHATSAPP_BROADCAST_RATE_LIMIT=50      # Broadcast messages per second per tenant

# ─────────────────────────────────────────────────────────────────────────────
# TikTok API
# ─────────────────────────────────────────────────────────────────────────────
TIKTOK_APP_ID=<REQUIRED>
TIKTOK_APP_SECRET=<REQUIRED>
TIKTOK_ACCESS_TOKEN=<REQUIRED>
TIKTOK_WEBHOOK_SECRET=<REQUIRED>

# ─────────────────────────────────────────────────────────────────────────────
# Instagram / Facebook API (via Meta Graph)
# ─────────────────────────────────────────────────────────────────────────────
INSTAGRAM_PAGE_ID=<REQUIRED>
INSTAGRAM_PAGE_ACCESS_TOKEN=<REQUIRED>
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=<REQUIRED>
# Names actually consumed by src/shared/core/config.py (Settings fields).
# Both must be provided via the environment — no defaults exist in code.
META_INSTAGRAM_PAGE_ID=<REQUIRED>
META_INSTAGRAM_PAGE_ACCESS_TOKEN=<REQUIRED>
META_INSTAGRAM_VERIFY_TOKEN=<REQUIRED>

# ─────────────────────────────────────────────────────────────────────────────
# X (Twitter) API
# ─────────────────────────────────────────────────────────────────────────────
X_API_KEY=<REQUIRED>
X_API_SECRET=<REQUIRED>
X_ACCESS_TOKEN=<REQUIRED>
X_ACCESS_TOKEN_SECRET=<REQUIRED>
X_BEARER_TOKEN=<REQUIRED>
X_WEBHOOK_ENV_NAME=<REQUIRED>

# ─────────────────────────────────────────────────────────────────────────────
# Snapchat API
# ─────────────────────────────────────────────────────────────────────────────
SNAPCHAT_APP_ID=<REQUIRED>
SNAPCHAT_CLIENT_ID=<REQUIRED>
SNAPCHAT_CLIENT_SECRET=<REQUIRED>
SNAPCHAT_ACCESS_TOKEN=<REQUIRED>
SNAPCHAT_WEBHOOK_SECRET=<REQUIRED>

# ─────────────────────────────────────────────────────────────────────────────
# AI / LLM Providers
# ─────────────────────────────────────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=<REQUIRED>
OPENAI_ORG_ID=<REQUIRED_optional>
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# OpenAI Models
LLM_L1_MODEL=gpt-4o-mini                  # Triage / fast routing model
LLM_L3_MODEL=gpt-4o                       # Master agent model
EMBEDDING_MODEL=text-embedding-3-small     # Cheap, fast embeddings
WHISPER_API_MODEL=whisper-1               # OpenAI Whisper (for <30s audio)

# Google AI (Gemini)
# GEMINI_API_KEY is the canonical credential used by the LLM Orchestrator.
# NEVER commit a real key — this file must only ever contain placeholders.
GEMINI_API_KEY=<REQUIRED>
GOOGLE_AI_API_KEY=<REQUIRED>
GOOGLE_AI_PROJECT_ID=<REQUIRED_optional>
GEMINI_L1_MODEL=gemini-2.0-flash-lite     # Triage model
GEMINI_L3_MODEL=gemini-2.0-pro            # Master agent model

# Anthropic (fallback)
ANTHROPIC_API_KEY=<REQUIRED_optional_fallback>

# Active LLM Provider (primary)
LLM_PRIMARY_PROVIDER=openai               # openai | gemini | anthropic

# Cost control
LLM_L0_MAX_DAILY_TOKENS=0                 # Semantic cache — no tokens
LLM_L1_MAX_DAILY_TOKENS=50000000          # L1 daily budget
LLM_L2_MAX_DAILY_TOKENS=10000000          # L2 daily budget
LLM_L3_MAX_DAILY_TOKENS=1000000           # L3 daily budget (expensive)
LLM_MONTHLY_BUDGET_USD=5000               # Kill switch at this spend

# LLM Routing thresholds
SEMANTIC_ROUTER_L1_THRESHOLD=0.75         # Complexity score → L1
SEMANTIC_ROUTER_L2_THRESHOLD=0.50         # Complexity score → L2
SEMANTIC_ROUTER_L3_THRESHOLD=0.25         # Complexity score → L3
AI_CONFIDENCE_ESCALATION_THRESHOLD=0.70   # < 70% confidence → human escalation

# ─────────────────────────────────────────────────────────────────────────────
# Multimodal (Voice & Vision)
# ─────────────────────────────────────────────────────────────────────────────
# Self-hosted Whisper (for audio > 30 seconds)
WHISPER_SELF_HOSTED_ENABLED=false          # Set true if GPU node pool available
WHISPER_SELF_HOSTED_MODEL_SIZE=large-v3
WHISPER_SELF_HOSTED_DEVICE=cpu             # cpu | cuda | mps
WHISPER_SELF_HOSTED_COMPUTE_TYPE=float32   # float32 | float16 (GPU only)
WHISPER_MAX_AUDIO_DURATION_SECONDS=600     # 10 minutes max
WHISPER_SHORT_AUDIO_THRESHOLD=30           # < 30s → use OpenAI API

# Vision LLM for image analysis
VISION_LLM_PROVIDER=openai                # openai | gemini
VISION_LLM_MODEL=gpt-4o                  # Vision-capable model
VISION_IMAGE_MAX_SIZE_MB=20
VISION_SUPPORTED_FORMATS=jpg,jpeg,png,heic,webp,pdf

# Audio temp file cleanup
MEDIA_VOICE_RETENTION_HOURS=24            # Auto-delete voice files after 24h
MEDIA_IMAGE_RETENTION_DAYS=7              # Auto-delete vision files after 7 days

# ─────────────────────────────────────────────────────────────────────────────
# REGA (Saudi Real Estate General Authority) API
# ─────────────────────────────────────────────────────────────────────────────
REGA_API_BASE_URL=https://api.rega.gov.sa
REGA_API_KEY=<REQUIRED>
REGA_API_TIMEOUT=15                       # seconds
REGA_API_MAX_RETRIES=3
REGA_CIRCUIT_BREAKER_THRESHOLD=5          # failures before open
REGA_CIRCUIT_BREAKER_RESET_TIMEOUT=60    # seconds
REGA_REVERIFICATION_CRON=0 2 * * *       # Daily at 2am Riyadh

# ─────────────────────────────────────────────────────────────────────────────
# Payment Gateways
# ─────────────────────────────────────────────────────────────────────────────
# Moyasar (simple payments: reports 29 SAR / 15 SAR, subscriptions)
MOYASAR_API_KEY=<REQUIRED>
MOYASAR_PUBLIC_KEY=<REQUIRED>
MOYASAR_WEBHOOK_SECRET=<REQUIRED>
MOYASAR_API_BASE=https://api.moyasar.com/v1

# Tap (marketplace split payments, brokerage commissions)
TAP_SECRET_KEY=<REQUIRED>
TAP_PUBLIC_KEY=<REQUIRED>
TAP_WEBHOOK_SECRET=<REQUIRED>
TAP_API_BASE=https://api.tap.company/v2

# Active payment provider per use case
PAYMENT_PROVIDER_REPORTS=moyasar          # moyasar | tap
PAYMENT_PROVIDER_SUBSCRIPTIONS=moyasar
PAYMENT_PROVIDER_COMMISSIONS=tap          # Split payments require Tap

# Idempotency window
PAYMENT_IDEMPOTENCY_TTL_SECONDS=604800    # 7 days

# B2C Report Prices (SAR)
REPORT_DEED_CHECK_PRICE_SAR=29.00
REPORT_MUNICIPAL_CONSULTING_PRICE_SAR=15.00

# ─────────────────────────────────────────────────────────────────────────────
# Google Calendar (Logistics Scheduling)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=<REQUIRED>
GOOGLE_CALENDAR_CLIENT_SECRET=<REQUIRED>
GOOGLE_CALENDAR_REDIRECT_URI=<REQUIRED>
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON_PATH=./secrets/google-calendar-sa.json

# Inspection logistics
INSPECTION_BUFFER_MINUTES=30              # Buffer between appointments
INSPECTION_REMINDER_HOURS_BEFORE=24,1    # Remind at 24h and 1h before

# Distance calculation (for travel cost estimation)
GOOGLE_MAPS_API_KEY=<REQUIRED>
INSPECTION_BASE_FEE_SAR=150
INSPECTION_PER_KM_RATE_SAR=2.5
INSPECTION_OVERNIGHT_FEE_SAR=350
INSPECTION_CONTINGENCY_MARGIN_PCT=15

# ─────────────────────────────────────────────────────────────────────────────
# VCard & Customer Engagement
# ─────────────────────────────────────────────────────────────────────────────
# VCard Gatekeeper state machine
VCARD_VALIDATION_TIMEOUT_HOURS=1          # Send STATE_REMINDER_1 after 1h
VCARD_REMINDER_2_DELAY_HOURS=24           # Send STATE_REMINDER_2 after 24h
VCARD_DORMANT_DELAY_DAYS=7               # Mark STATE_DORMANT after 7 days

# VIP Broadcast limits
VIP_MAX_MESSAGES_PER_WEEK=3              # Anti-spam policy
VIP_RESUBSCRIBE_COOLDOWN_DAYS=90         # Days before re-inviting declined users
VIP_ENGAGEMENT_SCORE_THRESHOLD=50        # Score needed to qualify for VIP invite

# Human Escalation SLA
ESCALATION_SLA_MINUTES=15                # Human must respond within 15 minutes
ESCALATION_MANAGER_ALERT_MINUTES=20      # Alert manager if agent doesn't respond

# ─────────────────────────────────────────────────────────────────────────────
# Observability (OpenTelemetry)
# ─────────────────────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=omniflow-backend
OTEL_SERVICE_VERSION=${APP_VERSION}
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317    # Jaeger gRPC endpoint
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1              # Sample 10% of traces in prod

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry (error tracking — optional)
SENTRY_DSN=                               # <REQUIRED in prod>
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────────────────────────────────────
# PDPL / Data Privacy Compliance
# ─────────────────────────────────────────────────────────────────────────────
PDPL_RTBF_ENABLED=true                   # Right-to-be-Forgotten
PDPL_DATA_RETENTION_YEARS=7              # SDAIA: 7-year record retention
PDPL_COLD_ARCHIVE_BUCKET=omniflow-cold-archive
PDPL_AUDIT_LOG_TABLE=pdpl_audit_events

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WEBHOOK_PER_MIN=300           # Max webhook calls per IP/min
RATE_LIMIT_API_PER_MIN=120              # Max API calls per authenticated user/min
RATE_LIMIT_LLM_PER_MIN=60              # Max LLM-invoking requests per user/min
RATE_LIMIT_PAYMENT_PER_HOUR=10         # Max payment attempts per user/hour

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags (runtime toggles — no deploy needed to change)
# ─────────────────────────────────────────────────────────────────────────────
FEATURE_MULTIMODAL_VOICE=true
FEATURE_MULTIMODAL_VISION=true
FEATURE_REPORTS_VAULT=true
FEATURE_VCARD_GATEKEEPER=true
FEATURE_VIP_BROADCAST=true
FEATURE_HUMAN_TAKEOVER=true
FEATURE_REGA_VERIFICATION=true
FEATURE_CLICKHOUSE_ANALYTICS=true
FEATURE_SEMANTIC_CACHE=true

# ─────────────────────────────────────────────────────────────────────────────
# Celery / Task Scheduling
# ─────────────────────────────────────────────────────────────────────────────
CELERY_TIMEZONE=Asia/Riyadh
CELERY_TASK_SOFT_TIME_LIMIT=300          # 5 minutes soft limit per task
CELERY_TASK_TIME_LIMIT=600              # 10 minutes hard limit
CELERY_MAX_RETRIES=5
CELERY_WORKER_CONCURRENCY=8

# ─────────────────────────────────────────────────────────────────────────────
# Alembic (Database Migrations)
# ─────────────────────────────────────────────────────────────────────────────
ALEMBIC_SCRIPT_LOCATION=src/shared/db/alembic
ALEMBIC_VERSION_TABLE=alembic_version

# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose Port Bindings (for local dev reference)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_EXPOSED_PORT=5432
PGBOUNCER_PORT=6432
REDIS_EXPOSED_PORT=6379
KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
SCHEMA_REGISTRY_PORT=8081
REDPANDA_PROXY_PORT=8082
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
MINIO_API_PORT=9020
MINIO_CONSOLE_PORT=9021
FLOWER_PORT=5555
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_UI_PORT=16686
PGADMIN_PORT=5050
REDPANDA_CONSOLE_PORT=8080
