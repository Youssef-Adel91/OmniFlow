# ═════════════════════════════════════════════════════════════════════════════
# OmniFlow AI — PRODUCTION environment template
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#   # fill in every <REQUIRED...> value, then run ./deploy.sh
#
# This single file is used twice:
#   1. by Docker Compose itself, to interpolate ${VAR} in docker-compose.prod.yml
#      and docker-compose.monitoring.yml  (the INFRASTRUCTURE section below);
#   2. as `env_file:` for fastapi-backend, nextjs-frontend, the AI workers and
#      the Celery services (the APPLICATION section below).
#
# The application section here is a REQUIRED-ONLY subset. The exhaustive,
# commented list of every tunable lives in ../omniflow-backend/.env.example —
# copy anything else you need to override from there.
#
# ⚠️ NEVER commit .env.prod. Generate every secret fresh for production; do not
#    reuse development values. Prefer a real secret manager (AWS Secrets
#    Manager / Vault) and inject at deploy time where possible.
# ═════════════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════════════
# SECTION 1 — INFRASTRUCTURE  (consumed by docker-compose *.yml)
# ═════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=omniflow
POSTGRES_PASSWORD=<REQUIRED_strong_password>
POSTGRES_DB=omniflow_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=<REQUIRED_strong_password>

# ── Qdrant (vector DB) ───────────────────────────────────────────────────────
QDRANT_API_KEY=<REQUIRED_strong_api_key>

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ROOT_USER=omniflow_admin
MINIO_ROOT_PASSWORD=<REQUIRED_strong_password_min_8_chars>

# ── Grafana (only used by docker-compose.monitoring.yml) ─────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<REQUIRED_strong_password>
GRAFANA_ROOT_URL=http://localhost:3001


# ═════════════════════════════════════════════════════════════════════════════
# SECTION 2 — APPLICATION  (consumed by the backend / frontend containers)
# ═════════════════════════════════════════════════════════════════════════════

# ── Application basics ───────────────────────────────────────────────────────
APP_NAME="OmniFlow AI"
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json
APP_WORKERS=4
APP_TIMEZONE=Asia/Riyadh

# ⚠️ CLIENT ACTION: replace SERVER_DOMAIN with the real domain (same value used
# in nginx/prod.conf).
API_BASE_URL=https://SERVER_DOMAIN
FRONTEND_URL=https://SERVER_DOMAIN
ALLOWED_ORIGINS=https://SERVER_DOMAIN,https://www.SERVER_DOMAIN

# ── Security / crypto ────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=<REQUIRED_256_bit_random_hex>
JWT_SECRET_KEY=<REQUIRED_256_bit_random_hex>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<REQUIRED_fernet_key_base64>

# ── Service connection strings (container DNS names, not localhost) ──────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable          # traffic stays on the private docker network
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PGBOUNCER_HOST}:${PGBOUNCER_PORT}/${POSTGRES_DB}

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SSL=false
REDIS_DB_CONVERSATIONS=0
REDIS_DB_RATE_LIMITING=1
REDIS_DB_IDEMPOTENCY=2
REDIS_DB_CELERY_BROKER=3
REDIS_DB_CELERY_RESULTS=4
REDIS_DB_CACHE=5
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB_CONVERSATIONS}

# ── Celery (celery-worker / celery-beat services) ────────────────────────────
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB_CELERY_BROKER}
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB_CELERY_RESULTS}
CELERY_TIMEZONE=Asia/Riyadh

# ── Kafka / Redpanda ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Object storage (MinIO via the S3 API) ────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_USE_PATH_STYLE=true
S3_VAULT_BUCKET=omniflow-reports-vault
S3_MEDIA_TEMP_BUCKET=omniflow-media-temp
S3_ASSETS_BUCKET=omniflow-public-assets
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

# ── Auth provider (Clerk) ────────────────────────────────────────────────────
CLERK_SECRET_KEY=<REQUIRED_from_clerk_dashboard>
CLERK_PUBLISHABLE_KEY=<REQUIRED_from_clerk_dashboard>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<REQUIRED_same_as_above>

# ── Meta / WhatsApp Business ─────────────────────────────────────────────────
META_APP_ID=<REQUIRED>
META_APP_SECRET=<REQUIRED>
META_WEBHOOK_HMAC_SECRET=<REQUIRED_from_meta_developer_console>
META_WHATSAPP_PHONE_NUMBER_ID=<REQUIRED>
META_WHATSAPP_BUSINESS_ACCOUNT_ID=<REQUIRED>
META_WHATSAPP_ACCESS_TOKEN=<REQUIRED_permanent_system_user_token>
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=<REQUIRED_random_string>

# ── LLM providers ────────────────────────────────────────────────────────────
# Fill in only the providers actually in use; see ../omniflow-backend/.env.example
# for the full routing configuration.
OPENAI_API_KEY=<REQUIRED_if_openai_is_used>
ANTHROPIC_API_KEY=<REQUIRED_if_anthropic_is_used>
GOOGLE_API_KEY=<REQUIRED_if_gemini_is_used>

# ── Frontend (Next.js build/runtime) ─────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://SERVER_DOMAIN/api
NODE_ENV=production

# ── Observability ────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=omniflow-backend
OTEL_METRICS_EXPORTER=prometheus
OTEL_TRACES_SAMPLER_ARG=0.1
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090               # scraped by docker-compose.monitoring.yml
SENTRY_DSN=                        # optional but strongly recommended in prod
SENTRY_ENVIRONMENT=production
